# Telegram
BOT_TOKEN=your_telegram_bot_token
OWNER_ID=your_telegram_user_id

# AI providers — add the keys you have. The router falls back automatically.
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-3.5-flash-lite
CEREBRAS_MODEL=llama-3.3-70b
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Provider priority: first available provider is tried first.
# Failed/rate-limited providers are temporarily cooled down, then retried later.
AI_PROVIDER_ORDER=groq,gemini,cerebras,openrouter
AI_PROVIDER_COOLDOWN_SECONDS=90

# Optional: persistent shared response-cache database path
# AI_RESPONSE_CACHE_PATH=bot/response_cache.sqlite3
